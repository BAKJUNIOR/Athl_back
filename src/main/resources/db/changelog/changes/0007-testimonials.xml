<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        Témoignages clients (carrousel accueil, voir Testimonial) : reprend le contenu réel qui
        était jusqu'ici codé en dur côté front (testimonials.data.ts), pour le rendre éditable
        depuis le BO. N'insère que si la table est vide : sur une base déjà remplie via le BO,
        rien n'est écrasé.
    -->

    <changeSet id="insert-testimonials" author="athl">
        <preConditions onFail="CONTINUE">
            <and>
                <tableExists tableName="testimonials"/>
                <sqlCheck expectedResult="0">SELECT COUNT(*) FROM testimonials</sqlCheck>
            </and>
        </preConditions>
        <insert tableName="testimonials">
            <column name="name" value="Emmanuel N'GUESSAN,"/>
            <column name="role_fr" value="Directeur Général Group"/>
            <column name="role_en" value="Group Chief Executive Officer"/>
            <column name="text_fr" value="« De la première visite à la livraison, tout était documenté et dans le budget. Les équipes ont traité le chantier comme le leur. »"/>
            <column name="text_en" value="“From the first visit to handover, everything was documented and on budget. The teams treated the site as if it were their own.”"/>
            <column name="photo" value="images/team-dg.jpg"/>
            <column name="initials" value="EN"/>
            <column name="sort_order" valueNumeric="1"/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>
        <insert tableName="testimonials">
            <column name="name" value="Beugré Alain Cédric,"/>
            <column name="role_fr" value="Responsable Communication Group"/>
            <column name="role_en" value="Group Communications Manager"/>
            <column name="text_fr" value="« L'équipe a dépassé nos attentes à chaque étape. Communication claire, planning respecté, et un bâtiment dont nos équipes sont fières. »"/>
            <column name="text_en" value="“The team exceeded our expectations at every stage. Clear communication, the schedule was met, and a building our teams are proud of.”"/>
            <column name="photo" value="images/team-comm.jpg"/>
            <column name="initials" value="BC"/>
            <column name="sort_order" valueNumeric="2"/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>
        <insert tableName="testimonials">
            <column name="name" value="Elisabeth TUO,"/>
            <column name="role_fr" value="Responsable Administrative et Comptable Group"/>
            <column name="role_en" value="Group Administration &amp; Accounting Manager"/>
            <column name="text_fr" value="« ATHL a mené une rénovation complexe avec professionnalisme et précision. Leur souci du détail et leur culture sécurité font vraiment la différence. »"/>
            <column name="text_en" value="“ATHL carried out a complex renovation with professionalism and precision. Their attention to detail and safety culture really make the difference.”"/>
            <column name="photo" value="images/team-admin.jpg"/>
            <column name="initials" value="ET"/>
            <column name="sort_order" valueNumeric="3"/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>
        <insert tableName="testimonials">
            <column name="name" value="Gnohéré Johannel Rosalyn Elisée,"/>
            <column name="role_fr" value="Gérant / Managing Director"/>
            <column name="role_en" value="Managing Director"/>
            <column name="text_fr" value="« ATHL, c'est une équipe qui tient parole : chaque chantier est mené avec la même exigence, du premier brief à la remise des clés. »"/>
            <column name="text_en" value="“ATHL is a team that keeps its word: every project is run with the same rigor, from the first brief to the final handover.”"/>
            <column name="photo" value="images/team_geran.jpeg"/>
            <column name="initials" value="GE"/>
            <column name="sort_order" valueNumeric="4"/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>
    </changeSet>

</databaseChangeLog>
