<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        Seed team_members avec le contenu réel déjà en production (voir /api/v1/team) : n'insère
        que si la table est entièrement vide, pour que les environnements neufs (local, autre
        instance) ne partent pas d'une page Équipe vide. Sur une base déjà remplie via le BO
        (comme la prod), rien n'est inséré ni écrasé.
    -->

    <changeSet id="seed-team-members" author="athl">
        <preConditions onFail="CONTINUE">
            <and>
                <tableExists tableName="team_members"/>
                <columnExists tableName="team_members" columnName="quote_fr"/>
                <sqlCheck expectedResult="0">SELECT COUNT(*) FROM team_members</sqlCheck>
            </and>
        </preConditions>
        <insert tableName="team_members">
            <column name="name" value="Emmanuel N'GUESSAN"/>
            <column name="role_fr" value="Directeur Général Group"/>
            <column name="role_en" value="Group Chief Executive Officer"/>
            <column name="photo" value="https://res.cloudinary.com/drfq0bt4z/image/upload/v1790269226/team/xpvczo5f2xpzd5mlwoiw.jpg"/>
            <column name="quote_fr" value="« De la première visite à la livraison, tout était documenté et dans le budget. Les équipes ont traité le chantier comme le leur. »"/>
            <column name="quote_en" value="“From the first visit to handover, everything was documented and on budget. The teams treated the site as if it were their own.”"/>
            <column name="initials" value="EN"/>
            <column name="sort_order" valueNumeric="1"/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>
        <insert tableName="team_members">
            <column name="name" value="Gnohéré Johannel Rosalyn Elisée"/>
            <column name="role_fr" value="Gérant / Managing Director (ATHL)"/>
            <column name="role_en" value="Gérant / Managing Director (ATHL)"/>
            <column name="photo" value="https://res.cloudinary.com/drfq0bt4z/image/upload/v1790335382/team/vtntccaxbjx190li4nhx.jpg"/>
            <column name="quote_fr" value="« ATHL, c'est une équipe qui tient parole : chaque chantier est mené avec la même exigence, du premier brief à la remise des clés. »"/>
            <column name="quote_en" value="“ATHL is a team that keeps its word: every project is run with the same rigor, from the first brief to the final handover.”"/>
            <column name="initials" value="GE"/>
            <column name="sort_order" valueNumeric="2"/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>
        <insert tableName="team_members">
            <column name="name" value="Elisabeth TUO"/>
            <column name="role_fr" value="Responsable administrative et Comptable"/>
            <column name="role_en" value="Responsable administrative et Comptable"/>
            <column name="photo" value="https://res.cloudinary.com/drfq0bt4z/image/upload/v1790336694/team/il2u1lciymlojelb7rya.jpg"/>
            <column name="quote_fr" value="« ATHL a mené une rénovation complexe avec professionnalisme et précision. Leur souci du détail et leur culture sécurité font vraiment la différence. »"/>
            <column name="quote_en" value="“ATHL carried out a complex renovation with professionalism and precision. Their attention to detail and safety culture really make the difference.”"/>
            <column name="initials" value="ET"/>
            <column name="sort_order" valueNumeric="3"/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>
        <insert tableName="team_members">
            <column name="name" value="Beugré Alain Cédric"/>
            <column name="role_fr" value="Responsable Communication Group"/>
            <column name="role_en" value="Responsable Communication Group"/>
            <column name="photo" value="https://res.cloudinary.com/drfq0bt4z/image/upload/v1790336776/team/wctpegvhyfxgrx2ctkix.jpg"/>
            <column name="quote_fr" value="« L'équipe a dépassé nos attentes à chaque étape. Communication claire, planning respecté, et un bâtiment dont nos équipes sont fières. »"/>
            <column name="quote_en" value="“The team exceeded our expectations at every stage. Clear communication, the schedule was met, and a building our teams are proud of.”"/>
            <column name="initials" value="BC"/>
            <column name="sort_order" valueNumeric="4"/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>
    </changeSet>

</databaseChangeLog>
