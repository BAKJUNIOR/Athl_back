            <column name="service_id" valueComputed="(SELECT id FROM services WHERE slug = 'logistique-transport')"/>
            <column name="step_number" value="03"/>
            <column name="title_fr" value="Transport &amp; suivi"/>
            <column name="title_en" value="Transport &amp; tracking"/>
