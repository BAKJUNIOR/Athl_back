<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        Projects (voir Project) : page /projets (groupée par métier) et sa fiche détail
        /projets/:slug. Ajoute slug, lien vers le métier (service_id), localisation/typologie/
        année/description, galerie — retire caption_fr/en et wide, remplacés par ce nouveau
        modèle. Seed avec 9 projets de démonstration en status DRAFT (jamais visibles
        publiquement avant publication côté BO) : contenu fictif à relire/remplacer, utilisé
        pour valider la vue avant la vraie saisie.
    -->

    <changeSet id="add-project-columns" author="athl">
        <preConditions onFail="CONTINUE">
            <and>
                <tableExists tableName="projects"/>
                <not>
                    <columnExists tableName="projects" columnName="slug"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="projects">
            <column name="slug" type="VARCHAR(255)"/>
            <column name="service_id" type="BIGINT"/>
            <column name="location_fr" type="VARCHAR(255)"/>
            <column name="location_en" type="VARCHAR(255)"/>
            <column name="typology_fr" type="VARCHAR(255)"/>
            <column name="typology_en" type="VARCHAR(255)"/>
            <column name="year" type="VARCHAR(255)"/>
            <column name="description_fr" type="TEXT"/>
            <column name="description_en" type="TEXT"/>
            <column name="sort_order" type="INT" defaultValueNumeric="0"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="projects" baseColumnNames="service_id"
                                  referencedTableName="services" referencedColumnNames="id"
                                  constraintName="fk_projects_service"/>
        <addUniqueConstraint tableName="projects" columnNames="slug" constraintName="uc_projects_slug"/>
    </changeSet>

    <changeSet id="drop-project-caption-wide-columns" author="athl">
        <preConditions onFail="CONTINUE">
            <and>
                <tableExists tableName="projects"/>
                <columnExists tableName="projects" columnName="caption_fr"/>
            </and>
        </preConditions>
        <dropColumn tableName="projects" columnName="caption_fr"/>
        <dropColumn tableName="projects" columnName="caption_en"/>
        <dropColumn tableName="projects" columnName="wide"/>
    </changeSet>

    <changeSet id="seed-projects" author="athl">
